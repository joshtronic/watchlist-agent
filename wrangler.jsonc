{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "watchlist-agent",
	"main": "src/worker/index.ts",
	// Oldest workerd in the tree (pinned by @cloudflare/vite-plugin).
	"compatibility_date": "2026-10-12",

	// Only reachable on the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "watchlist.fetchlogic.com", "custom_domain": true }],

	// Static assets come from the Vite client build; the worker handles /api.
	"assets": { "run_worker_first": ["/api/*"] },

	"durable_objects": {
		"bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],

	"vars": {
		// Injected at deploy: `wrangler deploy --var GIT_COMMIT:<sha>`.
		"GIT_COMMIT": "",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFb-6m0dtfu1GnRs"
	}
}
